{
  "expo": {
    "name": "ReVoice",
    "slug": "revoice",
    "scheme": "revoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/revoice-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gustavocypriano.revoice",
      "infoPlist": {
        "NSCameraUsageDescription": "ReVoice uses your camera to suggest possible communication intents from a photo.",
        "NSPhotoLibraryUsageDescription": "ReVoice uses a selected photo to suggest possible communication intents.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "package": "com.gustavocypriano.revoice",
      "adaptiveIcon": {
        "backgroundColor": "#07143B",
        "foregroundImage": "./assets/branding/revoice-android-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/branding/revoice-symbol-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ReVoice to understand the situation you choose to show.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ReVoice to use a photo to suggest communication options.",
          "cameraPermission": "Allow ReVoice to use the camera to suggest communication options."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ReVoice to listen only when you choose to record a Voice Intent.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset",
      "expo-speech-recognition"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca891d97-b37a-4c25-8d0d-18419c1cf2a6"
      }
    }
  }
}
